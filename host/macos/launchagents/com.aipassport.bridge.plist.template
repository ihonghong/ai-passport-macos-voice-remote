<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aipassport.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>@SUPPORT_DIR@/venv/bin/python</string>
        <string>@SUPPORT_DIR@/bridge/mac_shortcut_bridge.py</string>
        <string>--transport</string>
        <string>ble</string>
        <string>--config</string>
        <string>@SUPPORT_DIR@/config.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@SUPPORT_DIR@</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/AI Passport Bridge.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/AI Passport Bridge.error.log</string>
</dict>
</plist>
