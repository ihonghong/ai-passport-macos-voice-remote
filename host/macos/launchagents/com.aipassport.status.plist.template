<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aipassport.status</string>
    <key>ProgramArguments</key>
    <array>
        <string>@STATUS_APP@/Contents/MacOS/AI Passport Status</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/AI Passport Status.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/AI Passport Status.error.log</string>
</dict>
</plist>
